# Auth/backend vars come from secrets/oci.yaml via sops exec-env locally,
# and from GitHub Secrets in CI. infra/tofu-env.sh maps them for OpenTofu.
# Run:  just init         # one-time backend setup
#       just tf plan      # plan with OpenTofu
#       just tf apply     # apply with OpenTofu
#
# Only non-secret instance config goes here. ssh_public_key is sourced from
# secrets/oci.yaml key `oci-public-key` by infra/tofu-env.sh.
#
# The instance boots an Oracle platform image (default: Canonical Ubuntu 24.04)
# and is converted to NixOS in place — Always Free tenancies have
# custom-image-count = 0, so a built qcow2 cannot be imported as a custom image.

# platform_image_operating_system         = "Canonical Ubuntu"
# platform_image_operating_system_version = "24.04"
