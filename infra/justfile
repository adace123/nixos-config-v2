# justfile - OCI OpenTofu infrastructure management
# Run from root:  just -f infra/justfile <recipe>
# Run from infra/: just <recipe>

# Default recipe
default:
    @just --list

# ── Secrets ────────────────────────────────────────────────────────────────────

# Edit (or create) secrets/oci.yaml with sops
# Required keys: oci-tenancy-id (or oci-tenancy-ocid), oci-user-ocid,
#                oci-fingerprint, oci-region, oci-compartment-ocid,
#                oci-private-key, oci-public-key, r2-access-key-id,
#                r2-secret-access-key, r2-account-id, r2-bucket-name
edit-secrets:
    nix shell nixpkgs#sops nixpkgs#age -c sops ../secrets/oci.yaml

# ── OpenTofu commands ─────────────────────────────────────────────────────────

# Initialize OpenTofu with S3-compatible R2 backend.
init *ARGS:
    nix develop ../#infra -c env OCI_SECRETS_FILE=../secrets/oci.yaml ./tofu-env.sh init {{ARGS}}

# Run any tofu command with env from sops secrets
# Usage: just tf plan [-out=tfplan]
#        just tf apply [-auto-approve]
#        just tf destroy
# The OCI private key is written to a temp file and cleaned up on exit.
tf CMD *ARGS:
    nix develop ../#infra -c env OCI_SECRETS_FILE=../secrets/oci.yaml ./tofu-env.sh tofu {{CMD}} {{ARGS}}

# Alias for explicit OpenTofu naming: just tofu plan
tofu CMD *ARGS:
    nix develop ../#infra -c env OCI_SECRETS_FILE=../secrets/oci.yaml ./tofu-env.sh tofu {{CMD}} {{ARGS}}

# Plan and apply in one process so the temporary OCI private-key path matches.
plan-apply *ARGS:
    nix develop ../#infra -c env OCI_SECRETS_FILE=../secrets/oci.yaml ./tofu-env.sh plan-apply {{ARGS}}

# Apply, cycling the three fault domains until A1 capacity is available.
# `500-InternalError, Out of host capacity` is the normal Always Free state of
# the A1 pool. us-sanjose-1 has a single availability domain, so cycling fault
# domains over time is the only lever left (see docs/dathomir.md); a capacity
# failure leaves nothing behind, so attempts are safe to repeat. Stops
# immediately on any other error. MAX_ATTEMPTS / SLEEP_SECONDS override defaults.
apply-retry *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail

    max_attempts="${MAX_ATTEMPTS:-30}"
    sleep_seconds="${SLEEP_SECONDS:-60}"
    log="$(mktemp)"
    trap 'rm -f "$log"' EXIT
    fault_domains=(FAULT-DOMAIN-1 FAULT-DOMAIN-2 FAULT-DOMAIN-3)

    for ((i = 1; i <= max_attempts; i++)); do
        fd="${fault_domains[$(((i - 1) % ${#fault_domains[@]}))]}"
        echo "=== attempt $i/$max_attempts  fault_domain=$fd ==="
        if TF_VAR_fault_domain="$fd" \
            nix develop ../#infra -c env OCI_SECRETS_FILE=../secrets/oci.yaml \
            ./tofu-env.sh tofu apply -input=false -auto-approve -no-color "$@" >"$log" 2>&1; then
            echo "Capacity available in $fd — apply succeeded."
            grep -E "Apply complete|Outputs:" "$log" | tail -3
            exit 0
        fi
        if grep -qi "out of host capacity" "$log"; then
            echo "capacity unavailable in $fd"
        else
            echo "STOPPING: not a capacity failure —"
            grep -E "Error:|╷" "$log" | head -10
            exit 1
        fi
        sleep "$sleep_seconds"
    done

    echo "Gave up after $max_attempts attempts; A1 capacity is scarce at the moment."
    exit 2

# Destroy all OpenTofu-managed OCI resources after showing the plan.
destroy *ARGS:
    nix develop ../#infra -c env OCI_SECRETS_FILE=../secrets/oci.yaml ./tofu-env.sh tofu destroy {{ARGS}}
