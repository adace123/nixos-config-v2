# Nix build results
result
result-*

# Nix garbage collection roots
.gcroots/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup

# Python
__pycache__/
*.py[cod]

# Secrets (plaintext/temporary only — encrypted sops files are tracked)
secrets/*.txt
secrets/*.plaintext
secrets/*.decrypted
*.secret
*.key
*.pem

# Local development
.direnv/

# AI coding tooling artifacts
.commandcode/

# Target-specific files copied by nixos-anywhere (e.g., sops age key)
nixos-files/

# pre-commit
.pre-commit-config.yaml

# uv
.venv

# Terraform
infra/.terraform/
infra/*.tfstate
infra/tailscale/.terraform/
infra/tailscale/*.tfstate
infra/tailscale/*.tfstate.*
infra/crash.log
infra/crash.*.log
# Local variable files: never committed, and not currently used (everything
# environment-specific comes from secrets/oci.yaml via infra/tofu-env.sh), but
# ignored so one cannot be added by accident.
infra/terraform.tfvars
infra/*.auto.tfvars
# Saved plan written by `just -f infra/justfile plan-apply` (tofu plan -out=tfplan).
# Kept ignored: a saved plan can embed resolved variable values, including secrets
# passed in as TF_VAR_* (e.g. the Tailscale auth key), and it is never needed twice.
infra/tfplan

# Temporary sops plaintext
secrets/*-plaintext.*
.empryo
